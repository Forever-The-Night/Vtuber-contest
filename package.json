{
  "name": "vtuber-ai-contest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-sqlite-dev.mjs",
    "dev:postgres": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "data:cleanup-local": "node scripts/cleanup-local-data.mjs",
    "data:export-preserved": "prisma generate --schema scripts/sqlite-preserve.prisma && node scripts/export-preserved-sqlite.mjs",
    "data:import-preserved": "prisma generate && node scripts/import-preserved-postgres.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:deploy": "prisma db push --skip-generate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.0",
    "exifr": "^7.1.3",
    "jose": "^6.2.3",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "png-chunk-text": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
